# Copy to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your-groq-key
TAVILY_API_KEY=your-tavily-key
SERPER_API_KEY=your-serper-key   # optional fallback if Tavily is unset

# LLM (defaults shown; Groq's OpenAI-compatible endpoint)
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=1500
LLM_REASONING_EFFORT=low
MAX_RPM=6

# Scraper size caps (lower = fewer tokens)
SCRAPE_RESULTS=3
SCRAPE_CHARS=900
SCRAPE_TOTAL_CHARS=3000
OUTPUT_DIR=output
